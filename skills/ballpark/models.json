  "notes": [
    "Prices are USD per million tokens, standard (non-batch, non-fast) tier. Reasoning/thinking tokens bill as output on all three providers.",
    "cache_write defaults to the input price when absent (OpenAI and Gemini cache implicitly with no write premium; Anthropic charges 1.25x for 5-minute writes).",
    "aa_cost_per_task is Artificial Analysis' measured USD cost per Intelligence Index task at each effort level. Dividing it by the output price gives a token-volume index that is comparable across models whose input:output price ratio is similar (~1:5 for every model here).",
    "chars_per_token is a fallback heuristic for English prose only: ~4 for OpenAI/Gemini; Claude's tokenizer counts 15-20% more tokens than tiktoken, and Claude 4.7+ models count up to 1.35x more again.",
    "Gemini 3.5 Flash-Lite has an AA cost per task (0.69) but the page does not say which thinking level it ran at, so it is left out."
  ],
  "reference": {"model": "claude-opus-5-5", "effort": "high"},
  "tiers": {
    "_basis": "Reasoning tokens on the reference model at its 'high' effort: [low, expected, high]. 'frontier' expected is public (AA: Opus 5.5 high used 60.1k output tokens per index task); the other tiers are priors, scaled to stay below it.",
    "trivial":  {"tokens": [0, 50, 300],          "examples": "greeting, factual lookup, classification, one-line rewrite"},
    "simple":   {"tokens": [200, 800, 2500],      "examples": "short explanation, summarize given text, small code edit"},
    "moderate": {"tokens": [1000, 4000, 10000],   "examples": "multi-step reasoning, write a function or module, analyze a document"},
    "hard":     {"tokens": [5000, 15000, 40000],  "examples": "tricky debugging, proofs, competition math, architecture design"},
    "frontier": {"tokens": [30000, 60000, 120000], "examples": "research-grade problems, the hardest benchmark questions"}
  },
  "unmeasured_effort_ratio": {
    "_basis": "Assumption for levels no model has public data for (ratio to 'high').",
    "minimal": 0.1
  },
